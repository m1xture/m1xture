---
import Container from "../shared/Container/Container.astro";
import bgImg from "../../assets/background.jpg";
import { Image } from "astro:assets";
import StackList from "../StackList/StackList.astro";

const {
  t: { hero },
} = Astro.locals;
---

<section id="about" class="relative overflow-hidden py-44 lg:py-72">
  <Image
    src={bgImg}
    alt="dark background"
    class="absolute inset-0 w-full h-full object-cover -z-10 scale-125 blur-sm"
  />
  <Container class="lg:px-32">
    <div class="max-w-lg">
      <h1 class="text-5xl font-extrabold mb-4">{hero.title}</h1>
      <p class="text-lg text-balance mb-4">{hero.desc}</p>
      <StackList />
    </div>
  </Container>
</section>
