---
import "../styles/global.css";
const { lang } = Astro.locals;
import { Font } from "astro:assets";
const {
  t: { meta },
} = Astro.locals;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang === "ua" ? "uk" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicon -->

    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />

    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={meta.description} />

    <!-- OpenGraph -->

    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content="/favicon/favicon.webp" />
    <meta property="og:url" content="https://m1xture.xyz" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="m1xture" />

    <!-- Twitter -->

    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content="/favicon/favicon.webp" />

    <meta
      name="google-site-verification"
      content="2WFo_eCUD-wA--OndrxoDtfwarCRAhuToz_B3kovCFY"
    />

    <title>{meta.title}</title>
    <Font cssVariable="--font-golos" />
  </head>
  <body>
    <slot />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="71d7ba70-cc5e-42a3-8e26-dce8ef264b50"
      data-domains="m1xture.xyz,www.m1xture.xyz"></script>
  </body>
</html>
